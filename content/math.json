      "activities": [
        {
          "id": "m-addition-reading",
          "type": "reading",
          "title": "Combining two groups",
          "minutes": 8,
          "body": [
            "Adding means combining two groups to find how many there are in all.",
            "Example: 4 apples and 3 apples make 7 apples. You can count on from the bigger number: 4, then 5, 6, 7."
          ]
        },
        {
          "id": "m-addition-quiz",
          "type": "quiz",
          "title": "Addition check",
          "minutes": 6,
          "questions": [
            { "id": "m-addition-q1", "prompt": "7 + 8 = ?", "choices": ["13", "14", "15", "16"], "answer": 2, "hint": "Count on 8 from 7." },
            { "id": "m-addition-q2", "prompt": "9 + 6 = ?", "choices": ["14", "15", "16", "17"], "answer": 1, "hint": "Make 10 first: take 1 from the 6 and add it to the 9." },
            { "id": "m-addition-q3", "prompt": "12 + 5 = ?", "choices": ["15", "16", "17", "18"], "answer": 2, "hint": "Start at 12 and count up 5." }
          ]
        }
      ]
    },
    {
      "id": "m-subtraction",
      "name": "Subtraction within 20",
      "prereqs": ["m-addition"],
      "activities": [
        {
          "id": "m-subtraction-reading",
          "type": "reading",
          "title": "Taking away",
          "minutes": 8,
          "body": [
            "Subtraction finds how many are left after some are taken away, or how far apart two numbers are.",
            "Subtraction is the reverse of addition: if 9 + 6 = 15, then 15 - 6 = 9."
          ]
        },
        {
          "id": "m-subtraction-quiz",
          "type": "quiz",
          "title": "Subtraction check",
          "minutes": 6,
          "questions": [
            { "id": "m-subtraction-q1", "prompt": "15 - 6 = ?", "choices": ["7", "8", "9", "10"], "answer": 2, "hint": "Think of which number plus 6 makes 15." },
            { "id": "m-subtraction-q2", "prompt": "20 - 13 = ?", "choices": ["6", "7", "8", "9"], "answer": 1, "hint": "Count back 13 from 20, or count up from 13 to 20." },
            { "id": "m-subtraction-q3", "prompt": "18 - 9 = ?", "choices": ["8", "9", "10", "11"], "answer": 1, "hint": "Double 9 and check: what plus 9 makes 18?" }
          ]
        }
      ]
    },
