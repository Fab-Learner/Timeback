            { "id": "m-multiplication-q2", "prompt": "5 x 6 = ?", "choices": ["25", "30", "35", "56"], "answer": 1, "hint": "Count by fives six times." },
            { "id": "m-multiplication-q3", "prompt": "2 x 9 = ?", "choices": ["16", "17", "18", "19"], "answer": 2, "hint": "Two groups of nine." }
          ]
        }
      ]
    },
    {
      "id": "m-fractions",
      "name": "Unit fractions",
      "prereqs": ["m-multiplication"],
      "activities": [
        {
          "id": "m-fractions-reading",
          "type": "reading",
          "title": "What a unit fraction is",
          "minutes": 8,
          "body": [
            "A unit fraction has a numerator of 1, such as 1/4 or 1/8.",
            "It names one of equal parts. The more parts a whole is cut into, the smaller each part is."
          ]
        },
        {
          "id": "m-fractions-quiz",
          "type": "quiz",
          "title": "Fractions check",
          "minutes": 6,
          "questions": [
            { "id": "m-fractions-q1", "prompt": "Which is a unit fraction?", "choices": ["2/3", "1/5", "3/3", "4/2"], "answer": 1, "hint": "Look for a numerator of 1." },
            { "id": "m-fractions-q2", "prompt": "A pizza is cut into 8 equal slices and you eat 1. What fraction did you eat?", "choices": ["8/1", "1/8", "7/8", "1/7"], "answer": 1, "hint": "One part out of eight equal parts." },
            { "id": "m-fractions-q3", "prompt": "Which is larger, 1/2 or 1/4?", "choices": ["1/4", "1/2", "They are equal", "Neither"], "answer": 1, "hint": "Which whole is cut into fewer pieces?" }
          ]
        }
      ]
    }
